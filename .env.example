# Configuração de Porta do Frontend
PORT=3000

# API Backend (URL pública do servidor backend)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="sua-chave-secreta-aqui"

# WhatsApp (Número padrão para contato)
WHATSAPP_NUMBER="5511999999999"

# Curator.io Social Feeds
# Crie uma conta gratuita em curator.io, conecte seu Instagram e cole o ID do feed abaixo:
NEXT_PUBLIC_CURATOR_INSTAGRAM_FEED_ID=""

# Elfsight Instagram Widget (Opcional - limite de visualizações)
# 1. Crie conta gratuita em https://elfsight.com
# 2. Crie um widget "Instagram Feed" e conecte @globalpharmahuman
# 3. Copie o ID do widget (ex: "a1b2c3d4-e5f6-7890-abcd-ef1234567890")
# 4. Cole abaixo:
NEXT_PUBLIC_ELFSIGHT_INSTAGRAM_WIDGET_ID=""

# Instagram Iframe Widget (RECOMENDADO - 100% Gratuito e Ilimitado, igual o Facebook)
# 1. Crie uma conta gratuita em https://lightwidget.com ou https://snapwidget.com
# 2. Conecte sua conta do Instagram e gere o código de embed em formato Iframe
# 3. Copie APENAS a URL do atributo "src" do iframe gerado (ex: "https://lightwidget.com/widgets/12345.html")
# 4. Cole abaixo:
NEXT_PUBLIC_INSTAGRAM_IFRAME_URL=""

# ==========================================
# METODOS OFICIAIS (100% GRATUITOS E ILIMITADOS)
# ==========================================

# INSTAGRAM GRAPH API OFICIAL (Sem limite de views, robusto, cacheado no servidor)
# Crie uma conta de desenvolvedor na Meta e pegue o Token de longa duração e o Business ID
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ID=""

# FACEBOOK GRAPH API OFICIAL (Sem limite de views, robusto, cacheado no servidor)
# Crie uma conta de desenvolvedor na Meta, crie um app e pegue o Token da Página e o ID da Página
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_PAGE_ID=""

